# Optional — the app runs fully offline on deterministic mock data without any of these.
# Set them to switch each stage over to the real, ToS-compliant integration.

# Business discovery (Google Places API — Text Search, New)
# https://developers.google.com/maps/documentation/places/web-service/text-search
GOOGLE_PLACES_API_KEY=

# Brand imagery (official Instagram Graph API — requires the business to connect
# their own Instagram professional account and issue a long-lived access token).
# There is no ToS-compliant way to pull media from an arbitrary third-party account,
# so this only activates for accounts the business owner has connected themselves.
# https://developers.facebook.com/docs/instagram-api/guides/content-publishing
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
